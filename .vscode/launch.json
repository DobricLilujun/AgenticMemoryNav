{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Isaac Sim Preview (Livestream)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/preview_isaacsim_navigation_wasd_with_lingbot-map.py",
            "args": [
                "--config",
                "configs/isaacsim_realtime_agent_internscenes.yaml",
